# ==========================================
# OmniHarness .gitignore
# ==========================================

# --- Node & Frontend Build ---
node_modules/
dist/
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Rust & Cargo ---
target/
src-tauri/target/
src-tauri/target*/
**/*.rs.bk
Cargo.lock.orig

# --- Compiled Binaries & Symbols ---
*.exe
*.dll
*.so
*.dylib
*.pdb
*.lib
*.obj
*.exp
*.ilk
*.msi
*.appimage
*.dmg
*.deb

# --- Release Archives & Ship Artifacts ---
*.zip
*.tar.gz
*.7z
ship-parts/
ship-telegram.ps1
upload-resp.json

# --- Logs & Diagnostics ---
*.log
*.tmp
*.bak
*.orig
*.rej

# --- Runtime Databases & Local State ---
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
.harness/
.omniharness/trash/
providers_snapshot.json
workspaces_snapshot.json
telegram_config.json
bootstrap.json
bun.lock

# --- Local Environment & Secrets ---
.env
.env.*
!.env.example
*.pem
*.key
*.cert
AGENTS.md
CLAUDE.md
.omniharness/rules.md

# --- IDE & OS Metadata ---
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*~
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store

# --- Tauri Assets Allowlist ---
!src-tauri/icons/
